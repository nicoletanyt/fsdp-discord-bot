# Discord application: enable Message Content Intent in the Developer Portal.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated channel IDs. Approved public channels also approve their public threads.
DISCORD_ALLOWED_CHANNEL_IDS=

# Pi provider/model catalog identifiers. For Gemini, use a Google AI Studio API key.
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
AI_API_KEY=

# Existing, clean Git checkout on this branch, with an origin remote.
# Keep the checkout OUTSIDE this bot directory and outside DATA_DIR.
REPO_PATH=/opt/discord-agent/repository
REPO_BRANCH=main
# No automatic Git sync. Request it in Discord, e.g. @bot pull from main.
DATA_DIR=./data

# Bounded REST backfill per channel/thread, plus live indexing. 0 disables backfill.
HISTORY_BACKFILL_MESSAGES=500
HISTORY_ARCHIVED_THREADS=20
# Maximum channel/thread scopes per background sync and cross-channel search.
HISTORY_MAX_SCOPES=100
HISTORY_SYNC_SECONDS=300

# Hard ceilings: tool calls <=5, distinct file reads <=3, Discord results <=10,
# Discord token budget <=2000. Values above these ceilings fail startup.
MAX_TOOL_CALLS=5
MAX_REPO_FILES=3
MAX_READ_LINES=100
MAX_FILE_BYTES=1000000
TOOL_RESULT_BYTES=6000
DISCORD_MAX_RESULTS=10
# Uses at most this many UTF-8 bytes of retrieved Discord text, a conservative token bound.
DISCORD_TOKEN_BUDGET=2000
MAX_INPUT_BYTES=6000
CONTEXT_BYTES=48000
CONTEXT_TURNS=3
MAX_OUTPUT_TOKENS=1500
# Includes model calls for tool turns and retries.
MAX_MODEL_CALLS=9
REQUEST_TIMEOUT_SECONDS=120
MAX_CONCURRENT_REQUESTS=2
MAX_QUEUED_REQUESTS=10
USER_COOLDOWN_SECONDS=10
API_RETRIES=2
